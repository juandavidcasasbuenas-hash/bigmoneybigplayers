# Production serves both the website and Socket.IO from this port.
PORT=3001
# Optional when deploying frontend and backend on different origins.
# VITE_SERVER_URL=https://your-table-server.example.com
# ALLOWED_ORIGINS=https://your-poker-site.example.com

# ElevenLabs Eleven v3 through fal — server only, never VITE_FAL_KEY.
FAL_KEY=
VOICE_DAILY_CHAR_LIMIT=50000
# VOICE_CACHE_DIR=/path/to/persistent/voice-cache
